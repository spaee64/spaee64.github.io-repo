cd "/mnt/c/Users/spae64/Desktop/spae64 repo" 2>/dev/null || cd ~/spaee64.github.io-repo

cat > Release <<'EOF'
Origin: spae64
Label: spae64
Suite: stable
Version: 1.0
Codename: spae
Architectures: iphoneos-arm iphoneos-arm64
Components: main
Description: spae64 repo
EOF

echo "Date: $(date -R)" >> Release

echo "MD5Sum:" >> Release
for f in Packages Packages.gz; do 
    [ -f "$f" ] && echo " $(md5sum "$f" | cut -d' ' -f1) $(wc -c < "$f") $f" >> Release
done

echo "SHA1:" >> Release
for f in Packages Packages.gz; do 
    [ -f "$f" ] && echo " $(sha1sum "$f" | cut -d' ' -f1) $(wc -c < "$f") $f" >> Release
done

echo "SHA256:" >> Release
for f in Packages Packages.gz; do 
    [ -f "$f" ] && echo " $(sha256sum "$f" | cut -d' ' -f1) $(wc -c < "$f") $f" >> Release
done
